# UrbanGreen AI - Environment Configuration

# Google Earth Engine Credentials (Optional - system falls back to Open Geospatial if not provided)
# 1. Register a project on Google Cloud and enable Earth Engine API: https://earthengine.google.com/
# 2. Provide either Service Account credentials OR your authenticated Google Cloud Project ID
EE_PROJECT_ID=
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY_FILE=

# Geospatial Grid Settings
DEFAULT_GRID_SIZE_METERS=500
MAX_GRID_CELLS=200

# Rule-Based Prioritization Weights (must sum to 1.0)
WEIGHT_HEAT=0.35
WEIGHT_BUILT_UP=0.25
WEIGHT_ROAD_DENSITY=0.15
WEIGHT_EXPOSURE=0.15
WEIGHT_LOW_VEGETATION=0.10

# Reference Normalization Bounds (for consistent cross-city scoring)
LST_MIN=18.0
LST_MAX=48.0
NDVI_MIN=-0.1
NDVI_MAX=0.85
